# --- Contact form email delivery ---------------------------------------------
# The contact form (on /contact and the home page) sends submissions by email
# through Resend (https://resend.com — free tier is plenty for a contact form).
#
# 1. Create a Resend account and an API key.
# 2. Copy this file to `.env.local` and fill in RESEND_API_KEY.
# 3. Restart `npm run dev`.
#
# Without RESEND_API_KEY set, the form still works but submissions are only
# written to the server console (nothing is emailed).
RESEND_API_KEY=

# Where contact form submissions are delivered. Change this to update the
# recipient without touching any code.
CONTACT_TO_EMAIL=info@globaldistributer.com

# The "from" address shown on delivered emails. `onboarding@resend.dev` works
# for testing straight away; for production use an address on a domain you have
# verified in Resend, e.g. "Global Distributer <hello@yourdomain.com>".
CONTACT_FROM_EMAIL="Global Distributer <onboarding@resend.dev>"
